# Phlox environment template for Docker Compose.
#
#   cp .env.example .env
#   # edit .env - DB_ENCRYPTION_KEY is required
#   docker compose up -d --build
#
# docker-compose.yml reads this file automatically. Plain `docker run` users can
# pass the same values with repeated -e flags.

# --- Required ---------------------------------------------------------------
# Encryption key for the SQLCipher database. Generate one with:
#   openssl rand -hex 32
# Keep a copy somewhere safe: without it the data directory cannot be decrypted.
DB_ENCRYPTION_KEY=

# --- Networking -------------------------------------------------------------
# Host port published by docker-compose.yml (always bound to 127.0.0.1).
PHLOX_PORT=5000
# Which image `docker compose` runs; `docker compose build` tags it locally.
PHLOX_IMAGE=ghcr.io/bloodworks-io/phlox:latest
# Comma-separated browser origins allowed to call the API cross-origin.
# Default is EMPTY = same-origin only (recommended: the browser's same-origin
# policy then blocks other sites from reading API responses). Set to your
# public origin when serving via a reverse proxy, e.g. https://phlox.example.com
ALLOWED_ORIGINS=
# Extra Host header values the API will serve (DNS-rebinding defence).
# localhost/127.0.0.1 are always allowed; add your public hostname here.
ALLOWED_HOSTS=
# Reverse-proxy CIDRs whose X-Forwarded-For header may be trusted. Empty means
# "any private-range peer" (old behaviour). The compose file defaults to the
# Docker network ranges + loopback.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.0/8

# --- Runtime ----------------------------------------------------------------
# IANA timezone used for note timestamps and log entries, e.g. Asia/Tehran
TZ=Etc/UTC
# Sliding-window rate limiting on /api endpoints; recommended when reachable
# from outside a trusted network.
RATE_LIMIT_ENABLED=true
# Seed the bundled demo patients on an empty database (handy for evaluation).
PHLOX_DEMO_MODE=false
# Extra JSON merged into LLM requests as openai's extra_body. Note: this is
# parsed by the application, so keep it on one line.
LLM_EXTRA_BODY=

# --- Authentication behind a reverse proxy ----------------------------------
# Trust an authenticating proxy (Authelia/Traefik/Caddy) that forwards the
# username in a header. Only private-source connections are trusted.
PROXY_AUTH_ENABLED=false
PROXY_AUTH_USER_HEADER=X-Forwarded-User
# Comma-separated allowlist; empty means "any authenticated user". For
# multi-user deployments, set this: server.py warns when it is empty and the
# API is exposed.
PROXY_AUTH_ALLOWED_USERS=
# Set to 1 ONLY when publishing the API beyond loopback (host networking /
# non-loopback port mapping). The server refuses to start in that case unless
# PROXY_AUTH_ENABLED=true.
PHLOX_EXPOSE_PUBLIC=0
